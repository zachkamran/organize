{
  "name": "organize-ai",
  "version": "0.1.0",
  "description": "AI-powered CLI that looks at your screenshots and files, describes them, and organizes them into folders — multi-provider (Anthropic, OpenAI, Google).",
  "type": "module",
  "bin": {
    "organize": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build src/cli.ts --target=node --outdir dist",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "cli",
    "ai",
    "screenshots",
    "organize",
    "claude",
    "vision",
    "files"
  ],
  "license": "MIT",
  "author": "Zach Kamran",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zachkamran/organize.git"
  },
  "homepage": "https://github.com/zachkamran/organize#readme",
  "bugs": "https://github.com/zachkamran/organize/issues",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.81",
    "@ai-sdk/google": "^3.0.80",
    "@ai-sdk/openai": "^3.0.68",
    "ai": "^6.0.197",
    "commander": "^15.0.0",
    "jimp": "^1.6.1",
    "picocolors": "^1.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.2",
    "typescript": "^6.0.3"
  }
}
